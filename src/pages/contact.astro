---
import Base from '../layouts/Base.astro';
import CopyButton from '../components/CopyButton.astro';
import { contact, mailto, person, social } from '../config';
---

<Base title="Kontakt" description={`Kontakt zu ${person.name}: E-Mail ${contact.email}, Telefon ${contact.phoneDisplay}.`}>
  <section class="contact" aria-labelledby="contact-title">
    <h1 id="contact-title" class="t-h2">Kontaktiere mich</h1>
    <div class="info">
      <p class="lbl">E-Mail</p>
      <div class="val-row"><a class="val" href={mailto}>{contact.email}</a><CopyButton text={contact.email} /></div>
      <p class="lbl">Telefon</p>
      <a class="val" href={contact.phoneHref}>{contact.phoneDisplay}</a>
      <p class="lbl">Ort</p>
      <p class="val">
        {contact.showStreetAddress && contact.streetAddress && <>{contact.streetAddress}<br /></>}
        {contact.zip} {person.city}
      </p>
      <p class="lbl">Social</p>
      <p class="val val--links">
        <a href={social.instagram} rel="me noopener" target="_blank">Instagram</a>
        <a href={social.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .contact { padding: 140px 20px 100px; }
  .info { margin-top: 40px; }
  .lbl { font-weight: 300; color: var(--muted); }
  .val-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin: 1px 0 50px; }
  .val-row .val { margin: 0; }
  .val {
    display: block;
    margin: 1px 0 50px;
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  a.val:hover, .val--links a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .val--links { display: flex; flex-wrap: wrap; gap: 8px 32px; margin-bottom: 0; }

  @media (min-width: 810px) {
    .contact { padding: 180px var(--pad) 140px; }
    .info { margin-top: 80px; }
    .val { font-size: 24px; margin: 13px 0 40px; }
    .val-row { margin: 13px 0 40px; }
    .val--links { margin-bottom: 0; }
  }
</style>
