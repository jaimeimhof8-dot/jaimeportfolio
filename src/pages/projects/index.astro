---
import Base from '../../layouts/Base.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { projects } from '../../data/projects';
import { texts } from '../../config';
---

<Base title="Arbeiten"description="Ausgewählte Arbeiten von Jaime Imhof: Video, Social Media und Content-Produktion.">
  <section class="works" aria-labelledby="works-title">
    <h1 id="works-title" class="t-h2">Ausgewählte Arbeiten</h1>
    <p class="intro">{texts.worksIntro}</p>
    <ProjectGrid projects={projects} wide headingLevel={2} />
    <p class="next">Passt etwas davon zu deinem Projekt?</p>
    <a class="pill" href="/contact/">Kontakt aufnehmen</a>
  </section>
</Base>

<style>
  .works { padding: 120px 0 100px; text-align: center; }
  .next { margin: 80px auto 24px; padding-inline: 20px; }
  .intro { max-width: 34ch; margin: 32px auto 56px; padding-inline: 20px; box-sizing: content-box; }
  .works :global(.grid) { text-align: left; }
  @media (min-width: 810px) {
    .works { padding: 200px 0 140px; }
    .next { margin-top: 120px; font-size: 18px; }
    .intro { max-width: 58ch; margin: 48px auto 80px; font-size: 18px; line-height: 1.7; }
  }
</style>
