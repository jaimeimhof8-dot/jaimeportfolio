---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ContactCta from '../components/ContactCta.astro';
import { featured } from '../data/projects';
import { texts, person } from '../config';
import wald from '../../material/site/hero/luftbild-wald.jpg';
import berg from '../../material/site/hero/berggrat.jpg';
import velo from '../../material/site/hero/velo.jpg';
import burger from '../../material/site/hero/burger.jpg';
import tour from '../../material/site/hero/tour-de-suisse.jpg';
import bewegung from '../../material/site/hero/bewegung.jpg';
import saengerin from '../../material/site/who/saengerin.jpg';
import gitarrist from '../../material/site/who/gitarrist.jpg';

// Two image slots that switch together, in the hero.
const left = [
  { src: velo, alt: 'Frau fährt auf dem Velo durch die Stadt, Hintergrund verwischt' },
  { src: wald, alt: 'Kurvige Strasse durch einen Wald, von oben mit der Drohne' },
  { src: berg, alt: 'Person steht auf einem Berggrat über einem Alpenpanorama' },
];
const right = [
  { src: burger, alt: 'Burger auf einem grünen Brett, Nahaufnahme' },
  { src: tour, alt: 'Radfahrer im gelben Trikot jubelt im Ziel der Tour de Suisse' },
  { src: bewegung, alt: 'Tänzer in Bewegung mit Langzeitbelichtung, schwarz-weiss' },
];
---

<Base fullTitle={texts.homeTitle} description={texts.homeDescription}>
  <!-- 1. Hero: two switching photos; scrolling opens the grey name block from the middle. -->
  <section class="hero on-light" aria-labelledby="name">
    <div class="stage">
      <div class="side side--a" aria-hidden="true">
        {left.map((img, i) => (
          <Picture formats={['avif', 'webp']} src={img.src} alt="" widths={[480, 800, 1200]} sizes="(min-width: 810px) 50vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} class:list={['slide', { 'is-on': i === 0 }]} />
        ))}
      </div>
      <div class="side side--b" aria-hidden="true">
        {right.map((img, i) => (
          <Picture formats={['avif', 'webp']} src={img.src} alt="" widths={[480, 800, 1200]} sizes="(min-width: 810px) 50vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} class:list={['slide', { 'is-on': i === 0 }]} />
        ))}
      </div>
      <span class="mouse" aria-hidden="true"></span>
      <span class="scroll-hint" aria-hidden="true">Scroll<span>↓</span></span>
      <div class="name-block">
        <h1 id="name" class="name">{person.logo}</h1>
        <div class="facts">
          <p class="t-h5">Mediamatiker EFZ<br />aus Thun</p>
          <p class="t-h5 right">Video, Foto und<br />Social Content</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Ausgewählte Arbeiten -->
  <section id="arbeiten" class="works" aria-labelledby="works-title">
    <h2 id="works-title" class="t-h2">Ausgewählte Arbeiten</h2>
    <ProjectGrid projects={featured} />
    <p class="more"><a class="pill" href="/projects/">Alle Arbeiten</a></p>
  </section>

  <hr class="divider" />

  <!-- 3. Wer bin ich -->
  <section class="who" aria-labelledby="who-title">
    <div class="who-head">
      <h2 id="who-title" class="t-h2">Wer bin ich</h2>
      <div class="who-text">
        <p>Ich bin Mediamatiker EFZ mit Fokus auf Foto und Video. Am liebsten arbeite ich draussen und schätze die Vielfalt, die jedes Projekt mitbringt.</p>
        <a class="pill" href="/about/">Über mich</a>
      </div>
    </div>
    <div class="photos">
      <div class="ph ph1"><Picture formats={['avif', 'webp']} src={saengerin} alt="Sängerin auf der Bühne im Nebel, schwarz-weiss" widths={[400, 700, 1000]} sizes="(min-width: 810px) 35vw, 90vw" loading="lazy" /></div>
      <div class="ph ph2"><Picture formats={['avif', 'webp']} src={gitarrist} alt="Gitarrist in Bewegung, mit Langzeitbelichtung, schwarz-weiss" widths={[400, 700, 1000]} sizes="(min-width: 810px) 35vw, 90vw" loading="lazy" /></div>
      <div class="ph ph3"><Picture formats={['avif', 'webp']} src={bewegung} alt="Tänzer in Bewegung mit Langzeitbelichtung, schwarz-weiss" widths={[400, 700, 1000]} sizes="(min-width: 810px) 35vw, 90vw" loading="lazy" /></div>
    </div>
  </section>

  <hr class="divider" />

  <ContactCta />
</Base>

<style>
  /* Hero: the stage sticks while the grey block opens (1.2 screens), then the name holds for a moment. */
  .hero { position: relative; height: 250vh; height: 250svh; background: var(--light); }
  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    --p: 0;
    --q: 0;
  }
  /* Photos sit above the name: while they slide away they uncover it instead of covering text with text. */
  /* Phone: the grey block is open after 1 screen, then the name stays pinned for another 1.6 screens, so a fast swipe doesn't fly past it. */
  @media (max-width: 809px) { .hero { height: 360svh; } }
  .side { position: relative; z-index: 2; flex: none; height: 50%; width: calc((1 - var(--p)) * 100%); overflow: hidden; background: #fff; }
  .side--b { margin-left: auto; }
  /* Soft shade under the top bar so the navigation stays readable on bright photos. */
  .side::after { content: ''; position: absolute; inset: 0 0 auto; height: 140px; background: linear-gradient(rgb(0 0 0 / 0.45), transparent); pointer-events: none; }
  .side--b::after { display: none; }
  @media (min-width: 810px) { .side--b::after { display: block; } }
  .slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; }
  .slide.is-on { opacity: 1; }

  .mouse {
    display: none;
    position: absolute;
    left: 50%;
    bottom: 126px;
    width: 32px;
    height: 48px;
    margin-left: -16px;
    z-index: 3;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.3);
    opacity: calc(1 - var(--p) * 4);
  }
  .mouse::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 10px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: #fff;
    animation: wheel 1.6s var(--ease) infinite;
  }
  /* Touch: a text hint instead of the mouse symbol. */
  .scroll-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 126px;
    z-index: 3;
    display: grid;
    justify-items: center;
    gap: 6px;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.6);
    opacity: calc(1 - var(--p) * 4);
    pointer-events: none;
  }
  .scroll-hint span { font-size: 16px; animation: hint 1.6s var(--ease) infinite; }
  @keyframes hint { 50% { transform: translateY(5px); } }
  @media (hover: hover) and (pointer: fine) {
    .mouse { display: block; }
    .scroll-hint { display: none; }
  }
  @keyframes wheel { from { transform: translateY(0); opacity: 1; } to { transform: translateY(14px); opacity: 0; } }

  .name-block {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 20px;
    color: #000;
    opacity: var(--q);
    transform: translateY(calc((1 - var(--q)) * 12vh));
    pointer-events: none;
  }
  .name {
    color: #000;
    font-size: clamp(40px, 12.3vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-align: center;
    white-space: nowrap;
  }
  .facts { display: grid; gap: 20px; margin-top: 20px; text-align: center; }
  .facts .t-h5 { color: #000; }

  @media (min-width: 810px) {
    .stage { flex-direction: row; }
    .side { height: 100%; width: calc((1 - var(--p)) * 50%); }
    .name-block { padding: 60px calc(140 * var(--u)) 0; }
    .name { font-size: calc(180 * var(--u)); }
    .facts { grid-template-columns: 1fr 1fr; gap: 20px; margin: 20px calc(50 * var(--u)) 0; text-align: left; }
    .facts .right { text-align: right; }
  }

  /* Wer bin ich */
  .who { padding: 40px 0 100px; }
  .who-head { padding-inline: 20px; text-align: center; }
  .who-text { margin-top: 40px; text-align: left; }
  .who-text .pill { margin-top: 32px; }
  .photos { display: grid; gap: 20px; padding-inline: 20px; margin-top: 60px; }
  .ph { overflow: hidden; }
  .ph :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ph1 { aspect-ratio: 350 / 525; }
  .ph2 { aspect-ratio: 1; order: 0; }
  .ph3 { aspect-ratio: 350 / 406; }

  @media (min-width: 810px) {
    .who { padding: 100px 0; }
    .who-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 0 calc(120 * var(--u)) 0 calc(120 * var(--u));
      text-align: left;
    }
    .who-head { min-height: calc(230 * var(--u)); }
    .who-text { width: calc(440 * var(--u)); min-width: 320px; margin: 0; font-size: 18px; line-height: 1.7; }
    .who-text .pill { margin-top: 32px; margin-left: 0; }
    .photos { display: block; position: relative; padding: 0; margin-top: 0; height: calc(1752 * var(--u)); }
    .ph { position: absolute; width: calc(500 * var(--u)); }
    .ph1 { left: 0; top: 0; aspect-ratio: 500 / 800; }
    .ph2 { left: calc(940 * var(--u)); top: calc(649 * var(--u)); }
    .ph3 { left: 0; top: calc(1152 * var(--u)); aspect-ratio: 500 / 600; }
  }

  /* Ausgewählte Arbeiten */
  .works { padding: 80px 0 40px; text-align: center; }
  .works h2 { margin-bottom: 80px; }
  .works :global(.grid) { text-align: left; }
  .more { margin-top: 40px; }
  @media (min-width: 810px) {
    .works { padding: 100px 0; }
    .works h2 { margin-bottom: 81px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero { height: auto; }
    .stage { position: relative; height: auto; }
    .side, .mouse, .scroll-hint { display: none; }
    .name-block { position: relative; padding-block: 140px 100px; opacity: 1; transform: none; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.stage');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (stage && !reduce.matches) {
    // --p: how far the grey block has opened, --q: name block rising into place.
    let ticking = false;
    let opened = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      const wide = window.innerWidth >= 810;
      const y = window.scrollY;
      const p = Math.min(1, Math.max(0, y / (vh * (wide ? 1.2 : 1))));
      // The name only comes in once the photos have made room, so it never sits on top of them.
      const q = Math.min(1, Math.max(0, (p - 0.62) / 0.38));
      opened = p >= 1;
      stage.style.setProperty('--p', p.toFixed(4));
      stage.style.setProperty('--q', q.toFixed(4));
    };
    const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    update();
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);

    // Both slots switch to the next photo together.
    const sides = [...stage.querySelectorAll<HTMLElement>('.side')].map((s) => [...s.querySelectorAll<HTMLElement>('.slide')]);
    let i = 0;
    // No point in switching photos nobody sees: the hero is off screen or the grey block is fully open.
    let inView = true;
    new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; }).observe(stage.parentElement!);
    window.setInterval(() => {
      if (document.hidden || !inView || opened) return;
      i = (i + 1) % sides[0].length;
      sides.forEach((slides) => slides.forEach((img, n) => img.classList.toggle('is-on', n === i)));
    }, 1200);
  }
</script>
