---
interface Props {
  text: string;
  label?: string;
}
const { text, label = 'E-Mail-Adresse kopieren' } = Astro.props;
---

<!-- Copies the address in one click; the status text is announced to screen readers. -->
<button class="copy-btn" type="button" data-copy={text} aria-label={label}>
  <span class="copy-txt" aria-hidden="true">Kopieren</span>
  <span class="visually-hidden copy-status" aria-live="polite"></span>
</button>

<style>
  .copy-btn {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 16px;
    background: none;
    color: var(--text);
    font: 400 12px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease), transform 0.15s var(--ease);
  }
  .copy-btn:hover { border-color: var(--white); background: rgb(255 255 255 / 0.08); }
  .copy-btn:active { transform: scale(0.96); }
  .copy-btn.is-done { border-color: var(--white); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    const txt = btn.querySelector('.copy-txt')!;
    const status = btn.querySelector('.copy-status')!;
    let timer = 0;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        txt.textContent = 'Kopiert ✓';
        status.textContent = 'E-Mail-Adresse kopiert';
      } catch {
        // Clipboard blocked (old browser, no permission): fall back to the mail program.
        window.location.href = `mailto:${btn.dataset.copy}`;
        return;
      }
      btn.classList.add('is-done');
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        txt.textContent = 'Kopieren';
        status.textContent = '';
        btn.classList.remove('is-done');
      }, 2000);
    });
  });
</script>
