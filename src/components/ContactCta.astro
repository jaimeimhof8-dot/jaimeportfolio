---
import { Picture } from 'astro:assets';
import { mailto } from '../config';
import s1 from '../../material/site/strip/freundinnen.jpg';
import s2 from '../../material/site/strip/buehne-nebel.jpg';
import s3 from '../../material/site/strip/bassist.jpg';
import s4 from '../../material/site/strip/saenger-gitarre.jpg';
import s5 from '../../material/site/strip/burger-hand.jpg';
import s6 from '../../material/site/strip/zwei-freundinnen.jpg';

const strip = [
  { src: s1 },
  { src: s2 },
  { src: s3, pos: '52.8% 31.2%' },
  { src: s4, pos: '42.2% 31.8%' },
  { src: s5 },
  { src: s6 },
];
---

<!-- Closing section: question, "Schreib mir", tilted moving photo strip. -->
<section class="cta" aria-labelledby="cta-title">
  <h2 id="cta-title" class="t-h2">Hast du ein Projekt oder eine<br /> Stelle im Kopf?</h2>
  <a class="pill" href={mailto}>Schreib mir</a>
  <div class="strip" aria-hidden="true">
    <ul class="track">
      {strip.map((img) => (
        <li><Picture formats={['avif', 'webp']} src={img.src} alt="" widths={[320, 640]} sizes="310px" loading="lazy" style={img.pos ? `object-position:${img.pos}` : undefined} /></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cta {
    padding-top: 100px;
    text-align: center;
    overflow: hidden;
  }
  h2 { padding-inline: 20px; }
  .pill { margin-top: 40px; }
  .strip {
    margin: 70px 15px 0;
    padding-block: 2px 60px;
    transform: rotate(-3deg);
    mask-image: linear-gradient(90deg, #000 85%, transparent);
    -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
  }
  .track {
    display: flex;
    gap: 10px;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Only runs once the script has appended the copy that makes the loop seamless. */
  .track.is-running { animation: slide 40s linear infinite; }
  li { width: 300px; height: 208px; flex: none; }
  li :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .track.is-paused { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(calc(-50% - 5px)); } }

  @media (min-width: 810px) {
    .pill { margin-top: 41px; }
    .strip { margin: 88px calc(36 * var(--u)) 0; padding-bottom: 65px; }
  }
</style>

<script>
  // The strip only runs while it is on screen.
  document.querySelectorAll<HTMLElement>('.track').forEach((track) => {
    // The seamless loop needs every photo twice. The copy is added here, so the page itself lists each photo once.
    [...track.children].forEach((li) => {
      const copy = li.cloneNode(true) as HTMLElement;
      copy.setAttribute('aria-hidden', 'true');
      track.append(copy);
    });
    track.classList.add('is-running');
    new IntersectionObserver(([entry]) => track.classList.toggle('is-paused', !entry.isIntersecting)).observe(track);
  });
</script>
