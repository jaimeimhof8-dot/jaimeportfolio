---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  poster: ImageMetadata;
}

const { id, title, poster } = Astro.props;
---

<!-- Looks like the Framer YouTube embed (thumbnail + play button, red on hover); the player only loads after a click. -->
<div class="yt" data-id={id} data-title={title}>
  <Picture formats={['avif', 'webp']} src={poster} alt="" widths={[640, 1280]} sizes="(min-width: 810px) 86vw, 90vw" loading="lazy" class="yt-poster" />
  <button class="yt-play" type="button">
    <svg class="yt-icon" viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
      <path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#212121" />
      <path d="M45 24 27 14v20" fill="#fff" />
    </svg>
    <span class="visually-hidden">Video abspielen: {title}</span>
  </button>
  <noscript><a href={`https://www.youtube.com/watch?v=${id}`}>Video auf YouTube ansehen</a></noscript>
</div>

<style>
  .yt { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #000; }
  .yt-poster, .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .yt-play { position: absolute; inset: 0; width: 100%; border: 0; background: none; cursor: pointer; display: grid; place-items: center; }
  .yt-icon path:first-child { fill-opacity: 0.8; transition: fill 0.2s, fill-opacity 0.2s; }
  .yt-play:hover .yt-icon path:first-child { fill: #f00; fill-opacity: 1; }
  noscript a { position: absolute; left: 1rem; top: 1rem; color: #fff; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((box) => {
    box.querySelector('.yt-play')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      iframe.title = box.dataset.title ?? 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
