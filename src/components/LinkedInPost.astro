---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  // Activity ID from the post URL (…urn:li:activity:ID).
  id: string;
  title: string;
  poster: ImageMetadata;
  // CSS aspect-ratio of the poster, e.g. '16 / 9' for a video, '4 / 5' for a document.
  aspect?: string;
}

const { id, title, poster, aspect = '16 / 9' } = Astro.props;
const postUrl = `https://www.linkedin.com/feed/update/urn:li:activity:${id}`;
---

<!-- LinkedIn embed (poster + button); LinkedIn only loads after a click. -->
<div class="li-wrap">
  <div class="li" data-id={id} data-title={title} style={`aspect-ratio:${aspect}`}>
    <Picture formats={['avif', 'webp']} src={poster} alt="" widths={[504, 1008]} sizes="(min-width: 810px) 504px, 90vw" loading="lazy" class="li-poster" />
    <button class="li-load pill" type="button">Beitrag von LinkedIn laden</button>
  </div>
  <p class="li-note t-h6">Erst nach dem Klick verbindet sich dein Browser mit LinkedIn. <a href={postUrl} target="_blank" rel="noopener">Beitrag auf LinkedIn öffnen</a></p>
</div>

<style>
  .li-wrap { max-width: 504px; margin-inline: auto; }
  .li { position: relative; overflow: hidden; background: #000; }
  .li-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .li :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #fff; }
  .li-load { position: absolute; left: 50%; bottom: 20px; transform: translateX(-50%); cursor: pointer; }
  .li-note { margin-top: 14px; text-align: center; text-wrap: balance; }
  .li-note a { text-decoration: underline; text-underline-offset: 0.2em; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.li').forEach((box) => {
    box.querySelector('.li-load')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.linkedin.com/embed/feed/update/urn:li:activity:${box.dataset.id}`;
      iframe.title = box.dataset.title ?? 'LinkedIn-Beitrag';
      iframe.loading = 'lazy';
      // The embed has its own height (post text + media): give the box room.
      box.style.aspectRatio = 'auto';
      box.style.height = '760px';
      box.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
